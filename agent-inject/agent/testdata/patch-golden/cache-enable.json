              "exit_on_retry_failure": true
            },
            "vault": {
              "address": "http://foobar:8200"
            }
          }
        }
      ],
      "image": "foobar-image",
      "lifecycle": {},
      "name": "vault-agent",
      "resources": {
        "limits": {
          "cpu": "500m",
          "memory": "128Mi"
        },
