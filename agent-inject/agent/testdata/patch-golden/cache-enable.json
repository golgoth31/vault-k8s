          "mountPath": "/vault/agent-cache",
          "name": "vault-agent-cache"
        }
      ]
    }
  },
  {
    "op": "add",
    "path": "/metadata/annotations/vault.hashicorp.com~1agent-inject-status",
    "value": "injected"
  }
]
