[
  {
    "op": "add",
    "path": "/spec/volumes/-",
    "value": {
      "emptyDir": {
        "medium": "Memory"
      },
      "name": "home-init"
    }
  },
  {
    "op": "add",
    "path": "/spec/volumes/-",
    "value": {
      "emptyDir": {
        "medium": "Memory"
      },
      "name": "home-sidecar"
    }
  },
  {
    "op": "add",
    "path": "/spec/volumes/-",
    "value": {
      "emptyDir": {
        "medium": "Memory"
      },
      "name": "vault-secrets"
    }
  },
  {
    "op": "add",
    "path": "/spec/volumes/-",
    "value": {
      "emptyDir": {
        "medium": "Memory"
      },
      "name": "vault-agent-cache"
    }
  },
  {
    "op": "add",
    "path": "/spec/containers/0/volumeMounts/-",
    "value": {
      "mountPath": "/vault/secrets",
      "name": "vault-secrets"
    }
  },
  {
    "op": "add",
    "path": "/spec/containers/1/volumeMounts",
    "value": [
      {
        "mountPath": "/vault/secrets",
        "name": "vault-secrets"
      }
    ]
  },
  {
    "op": "add",
    "path": "/spec/initContainers",
    "value": [
      {
        "args": [
          "echo ${VAULT_CONFIG?} | base64 -d > /home/vault/config.json && vault agent -config=/home/vault/config.json"
        ],
        "command": [
          "/bin/sh",
          "-ec"
        ],
        "env": [
          {
            "name": "NAMESPACE",
            "valueFrom": {
              "fieldRef": {
                "fieldPath": "metadata.namespace"
              }
            }
          },
          {
            "name": "HOST_IP",
            "valueFrom": {
              "fieldRef": {
                "fieldPath": "status.hostIP"
              }
            }
          },
          {
            "name": "POD_IP",
            "valueFrom": {
              "fieldRef": {
                "fieldPath": "status.podIP"
              }
            }
          },
          {
            "name": "VAULT_LOG_LEVEL",
            "value": "info"
          },
          {
            "name": "VAULT_LOG_FORMAT",
            "value": "standard"
          },
          {
            "name": "HTTPS_PROXY",
            "value": "http://proxy:3128"
          },
          {
            "name": "VAULT_CONFIG",
            "value": {
              "auto_auth": {
                "method": {
                  "config": {
                    "role": "app",
                    "token_path": "/var/run/secrets/kubernetes.io/serviceaccount/token"
                  },
                  "mount_path": "test",
                  "type": "kubernetes"
                },
                "sink": [
                  {
                    "config": {
                      "path": "/home/vault/.vault-token"
                    },
                    "type": "file"
                  }
                ]
              },
              "cache": {
                "persist": {
                  "path": "/vault/agent-cache",
                  "type": "kubernetes"
                },
                "use_auto_auth_token": "true"
              },
              "exit_after_auth": true,
              "listener": [
                {
                  "address": "127.0.0.1:8200",
                  "tls_disable": true,
                  "type": "tcp"
                }
              ],
              "pid_file": "/home/vault/.pid",
              "template": [
                {
                  "contents": "{{ with secret \"secret/data/db\" }}{{ range $k, $v := .Data }}{{ $k }}: {{ $v }}\n{{ end }}{{ end }}",
                  "destination": "/vault/secrets/db",
                  "left_delimiter": "{{",
                  "right_delimiter": "}}"
                }
              ],
              "template_config": {
                "exit_on_retry_failure": true
              },
              "vault": {
                "address": "http://foobar:8200"
              }
            }
          }
        ],
        "image": "foobar-image",
        "name": "vault-agent-init",
        "resources": {
          "limits": {
            "cpu": "500m",
            "memory": "128Mi"
          },
          "requests": {
            "cpu": "250m",
            "memory": "64Mi"
          }
        },
        "securityContext": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "readOnlyRootFilesystem": true,
          "runAsGroup": 1000,
          "runAsNonRoot": true,
          "runAsUser": 100
        },
        "volumeMounts": [
          {
            "mountPath": "/home/vault",
            "name": "home-init"
          },
          {
            "mountPath": "/var/run/secrets/kubernetes.io/serviceaccount",
            "name": "kube-api-access",
            "readOnly": true
          },
          {
            "mountPath": "/vault/secrets",
            "name": "vault-secrets"
          },
          {
            "mountPath": "/vault/agent-cache",
            "name": "vault-agent-cache"
          }
        ]
      }
    ]
  },
  {
    "op": "add",
    "path": "/spec/containers/-",
    "value": {
      "args": [
        "echo ${VAULT_CONFIG?} | base64 -d > /home/vault/config.json && vault agent -config=/home/vault/config.json"
